---
import Layout from "../layouts/Layout.astro";

const features = [
  {
    title: "All Series. One Place.",
    desc: "F1, MotoGP, IndyCar, WEC, IMSA and more no more jumping between 10 different apps.",
    icon: "🏁",
  },
  {
    title: "Your Time Zone. Always.",
    desc: "Automatically converts every session to your local time. No more mental math at 3 AM.",
    icon: "🌍",
  },
  {
    title: "Filter What You Love",
    desc: "Follow only the series and drivers you care about.",
    icon: "🎯",
  },
  {
    title: "Smart Notifications",
    desc: "Set alarms and reminders for races you follow",
    icon: "🔔",
  },
  {
    title: "New Fan Friendly",
    desc: "Confused where to watch? We show streaming/live TV options per country.",
    icon: "👋",
  },
  {
    title: "Cross Platform",
    desc: "Built using modern web technologies Track Time leverages progressive web apps for Offline support, tiny bundle size, instant loading — even on slow connections.",
    icon: "⚡",
  },
];

const { data } = await Astro.locals.supabase.auth.getClaims();

if (data?.claims.aud === "authenticated") return Astro.redirect("/app");
---

<Layout title="Track Time | Never Miss Another Race">
  <header class="bg-black p-8">
    <nav class="flex justify-between items-center">
      <a href="/" class="text-4xl font-black italic tracking-tighter">
        <span class="text-[#EF1A2D]">Short</span><span class="text-[#FF8000]"
          >Shift</span
        >
      </a>

      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="bg-[#FF8000] hover:opacity-90 text-white font-bold px-5 py-2.5 rounded-md"
        >
          Sign in
        </a>
        <a
          href="/signup"
          class="bg-[#EF1A2D] hover:opacity-90 text-white font-bold px-5 py-2.5 rounded-md"
        >
          Sign up
        </a>
      </div>
    </nav>
  </header>
  <main>
    <section class="flex items-center justify-center min-h-[50vh] bg-black">
      <div class="max-w-4xl text-center">
        <h1 class="text-7xl md:text-8xl font-black tracking-tight text-white">
          Never Miss Another Race
        </h1>

        <p class="mt-8 text-xl text-gray-300 max-w-lg mx-auto">
          The ultimate motorsport schedule aggregator. Track every race, every
          series, everywhere.
        </p>
      </div>
    </section>

    <section id="features" class="py-24 px-6 bg-[#0a0a0a]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2
            class="text-5xl md:text-6xl font-black text-white mb-4 tracking-tight"
          >
            YOUR <span
              class="bg-gradient-to-r from-[#FF2800] to-[#FF8000] bg-clip-text text-transparent"
              >PIT WALL</span
            > COMMAND CENTER
          </h2>
          <p class="text-gray-500 text-lg max-w-2xl mx-auto">
            Everything you need to stay ahead of the pack.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            features.map((feature) => (
              <div class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-[#FF8000] hover:bg-white/[0.07] transition-all hover:shadow-xl hover:shadow-[#FF2800]/10 hover:-translate-y-1">
                <div class="w-14 h-14 bg-linear-to-br from-[#FF2800]/20 to-[#FF8000]/20 rounded-xl flex items-center justify-center text-3xl mb-5 group-hover:scale-110 transition-transform">
                  {feature.icon}
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                  {feature.title}
                </h3>
                <p class="text-gray-500 leading-relaxed">{feature.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <footer class="bg-[#040404] border-t border-zinc-900">
    <div class="py-16 px-6 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-lg font-black tracking-tighter italic">
              <span class="text-[#FF2800]">TRACK</span><span
                class="text-[#FF8000]">TIME</span
              >
            </span>
          </div>
          <p class="text-zinc-500 text-sm leading-relaxed max-w-sm">
            Engineered for motorsport fans by motorsport fans.
          </p>
          <p class="text-xs text-zinc-600 mt-8">
            © 2026 Track Time. All rights reserved. All trademarks are property
            of their respective owners in the US and other countries.
          </p>
        </div>

        <div>
          <h4
            class="text-xs font-black text-zinc-400 mb-4 uppercase tracking-widest"
          >
            Platform
          </h4>
          <ul class="space-y-3 text-zinc-500 text-sm font-medium">
            <li>
              <a href="#features" class="hover:text-white transition"
                >Features</a
              >
            </li>
            <li>
              <a href="/login" class="hover:text-white transition"
                >Dashboard Link</a
              >
            </li>
            <li>
              <a href="/privacy" class="hover:text-white transition"
                >Privacy Policy</a
              >
            </li>
            <li>
              <a href="/terms" class="hover:text-white transition"
                >Terms of Service</a
              >
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="text-xs font-black text-zinc-400 mb-4 uppercase tracking-widest"
          >
            Connect
          </h4>
          <ul class="space-y-3 text-zinc-500 text-sm font-medium">
            <li>
              <a href="" target="_blank" class="hover:text-[#FF8000] transition"
                >Twitter / X</a
              >
            </li>
            <li>
              <a href="" target="_blank" class="hover:text-[#FF8000] transition"
                >Instagram</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
</Layout>
