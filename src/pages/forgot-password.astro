---
import { actions } from "astro:actions";
import Layout from "../layouts/Layout.astro";

const result = Astro.getActionResult(actions.authentication.forgotPassword);
---

<Layout title="Forgot Password | Short Shift">
  <header class="p-8 flex justify-center md:justify-start">
    <div class="text-4xl font-black italic tracking-tighter">
      <a href="/"
        ><span class="text-[#FF2800]">Short</span><span class="text-[#FF8000]"
          >Shift</span
        ></a
      >
    </div>
  </header>
  <main class="flex flex-col items-center">
    <h1 class="text-lg text-center font-bold">Reset your password</h1>
    {
      result?.error?.message ? (
        <p
          id="error"
          class="p-4 m-2 w-md rounded-lg bg-red-100 border border-red-400 text-red-700 text-center"
        >
          {result.error.message}
        </p>
      ) : result ? (
        <p
          id="success"
          class="p-4 m-2 w-md rounded-lg bg-green-100 border border-green-400 text-green-700 text-center"
        >
          A reset email has been sent. Check your inbox.
        </p>
      ) : null
    }
    <form
      method="post"
      action={actions.authentication.forgotPassword}
      class="max-w-md px-6 py-8 bg-white rounded-xl shadow-lg"
    >
      <label for="email" class="text-sm font-medium text-gray-700 mb-2">
        Email:
        <input
          type="text"
          name="email"
          placeholder="Enter your email address"
          autofocus
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#00A0DE] focus:outline-none mb-4"
        />
      </label>

      <button
        class="w-full bg-[#FF2800] hover:bg-[#ff451a] disabled:bg-[#FF2800]/50 disabled:cursor-not-allowed text-white font-bold py-3 rounded-lg cursor-pointer"
      >
        Send password reset email
      </button>
    </form>
  </main>
  <footer></footer>
</Layout>
