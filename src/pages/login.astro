---
import Layout from "../layouts/Layout.astro";

const { data } = await Astro.locals.supabase.auth.getClaims();

// We're already logged in send them to the dashboard
if (data?.claims.aud === "authenticated") return Astro.redirect("/app");

const ALERT: string | null = await Astro.session?.get("alert") || null;
const REDIRECT_TO = Astro.url.searchParams.get("redirect_to");
---

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";

  const LOGIN_FORM = document.getElementById("loginForm") as HTMLFormElement;
  const LOGIN_BUTTON = document.getElementById(
    "loginButton",
  ) as HTMLButtonElement;

  async function login() {
    LOGIN_BUTTON.disabled = true;
    LOGIN_BUTTON.textContent = "Logging in...";
    LOGIN_BUTTON.setAttribute("aria-busy", "true");

    const LOGIN_DATA = new FormData(LOGIN_FORM);
    const { error } = await actions.authentication.signIn(LOGIN_DATA);

    LOGIN_BUTTON.disabled = false;
    LOGIN_BUTTON.textContent = "Log In";
    LOGIN_BUTTON.setAttribute("aria-busy", "false");

    const ALERT_ELEMENT = document.getElementById("alert") as HTMLParagraphElement;

    if (error) {
      ALERT_ELEMENT.hidden = false;
      ALERT_ELEMENT.innerText = error.message;
      return;
    }

    ALERT_ELEMENT.hidden = true;

    return navigate(LOGIN_DATA.get("redirect-to")?.toString() ?? "/app");
  }

  LOGIN_FORM?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();
    await login();
  });
</script>

<Layout title="Login | Short Shift">
  <header class="p-8 flex justify-center md:justify-start">
    <div class="text-4xl font-black italic tracking-tighter">
      <a href="/"
        ><span class="text-[#FF2800]">Short</span><span class="text-[#FF8000]"
          >Shift</span
        ></a
      >
    </div>
  </header>
  <main class="flex items-center justify-center">
    <form
      id="loginForm"
      class="w-full max-w-md px-6 py-8 bg-white rounded-xl shadow-lg"
    >
      <h2 class="text-2xl text-gray-900 mb-6 text-center font-black">
        Welcome back!
      </h2>

      <p id="alert" class="mb-6 p-4 rounded-lg bg-red-100 border border-red-400 text-red-700 text-center" hidden={!ALERT}>
        {ALERT}
      </p>

      <input type="hidden" name="redirect-to" value={REDIRECT_TO} />

      <label for="email" class="text-sm font-medium text-gray-700 mb-2">
        Email

        <input
          autofocus
          id="email"
          type="email"
          name="email"
          autocomplete="username"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#00A0DE] focus:outline-none mb-4"
        />
      </label>

      <label
        for="password"
        class="block text-sm font-medium text-gray-700 mb-2 relative"
      >
        Password

        <input
          id="password"
          type="password"
          name="password"
          autocomplete="current-password"
          required
          class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#00A0DE] focus:outline-none mb-6"
        />
        <a
          href="/forgot_password"
          class="absolute top-0 right-0 hover:underline text-blue-600"
          >Forgot Password</a
        >
      </label>

      <button
        id="loginButton"
        type="submit"
        class="w-full bg-[#FF2800] hover:bg-[#ff451a] disabled:bg-[#FF2800]/50 disabled:cursor-not-allowed text-white font-bold py-3 rounded-lg cursor-pointer"
      >
        Log In
      </button>
    </form>
  </main>
  <footer class="text-center py-6 text-gray-500 text-sm">
    <span>Don't have an account?</span>
    <a href="/signup" class="text-[#00A0DE] hover:text-[#00c0ff] font-bold pl-1"
      >Sign up</a
    >
  </footer>
</Layout>
